{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invoice-studio",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "invoice-studio-production",
      "database_id": "invoice-studio-db"
    }
  ]
}