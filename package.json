{
  "name": "invoice-studio",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:d1": "wrangler pages dev dist --d1=invoice-studio-production --local --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply invoice-studio-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply invoice-studio-production",
    "db:seed": "wrangler d1 execute invoice-studio-production --local --file=./seed.sql"
  },
  "dependencies": {
    "hono": "^4.10.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241112.0",
    "@hono/vite-cloudflare-pages": "^0.4.2",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}